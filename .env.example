RUST_LOG=info
# 0.0.0.0 to reach the dev server from another machine (e.g. over Tailscale);
# 127.0.0.1 to keep it on this box only. Google OAuth's local callback has to be
# 127.0.0.1, so the redirect URI stays on loopback either way.
LEPTOS_SITE_ADDR=127.0.0.1:3100

# Off in dev, on in production (set in the Dockerfile). `cargo leptos watch`
# regenerates the unhashed pkg/geekgallery.css but never the hashed copy, so
# with this on, dev serves stale CSS and your edits appear to do nothing.
# cargo-leptos also reads this file at BUILD time -- see README.
LEPTOS_HASH_FILES=false

# ---- the flavor -------------------------------------------------------------
# Everything that makes this deployment a particular site. Every key has a
# default (a grey gallery called "geekgallery" whose items are "items"), so
# leave any of these out. FLAVORS.md is the full list with every default; in
# production the same keys travel as one blob, GALLERY_ENV.
SITE_ORIGIN=http://127.0.0.1:3100
SITE_NAME=
SITE_NOUN=
SITE_NOUN_PLURAL=
SITE_SUBJECT=
SITE_TAGLINE=
SITE_DESCRIPTION=
# Paragraphs separated by a literal \n (two characters).
SITE_ABOUT=
SITE_ALTERNATE_NAMES=
SITE_CONTACT_EMAIL=
SITE_REPO_URL=
# name=url, name=url
SITE_SISTER_SITES=
# heart | mic | droplet | star | thumbs_up | flame | zap | laugh
SITE_LIKE_ICON=
SITE_LIKE_VERB=
SITE_LIKE_UNDO=
SITE_LIKE_SORT_LABEL=
# #rrggbb each; the accent's hover/active/muted variants are derived when unset.
THEME_BG=
THEME_SURFACE=
THEME_SURFACE_RAISED=
THEME_SURFACE_HOVER=
THEME_LINE=
THEME_LINE_STRONG=
THEME_INK=
THEME_INK_2=
THEME_INK_3=
THEME_ACCENT=
THEME_ACCENT_HOVER=
THEME_ACCENT_ACTIVE=
THEME_ACCENT_MUTED=
THEME_ACCENT_INK=
THEME_DANGER=
THEME_OK=
# Where logo.png, logo-large.png, favicon-32/192/512.png and
# apple-touch-icon.png live. Default /brand is the placeholder art in public/.
SITE_ASSETS_BASE=
SITE_ASSETS_VERSION=
SITE_LOGO_WIDTH=
SITE_LOGO_HEIGHT=
SITE_LOGO_HAS_NAME=

# ---- infrastructure ---------------------------------------------------------
# Cloudflare D1. Local dev talks to the same D1 database as production —
# there is no local database at all, deliberately (see README).
# scripts/cloudflare-provision.sh prints all of these.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# Cloudflare R2 (media storage). Falls back to local disk under ./uploads
# when unset, which is fine for a quick local check but does not reflect how
# uploads behave in production.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# No content-moderation settings: nothing inspects an upload's contents. There
# is no classifier, no sidecar, no thresholds to tune. Uploads publish as they
# arrive; the report queue in /admin and the three-report auto-hide are the
# moderation mechanism.

# Importing from links (the paste-a-link box on /upload). All optional; the
# Dockerfile puts yt-dlp, deno and ffmpeg on PATH so nothing needs setting in
# production. Locally, point at your own binaries if they are not on PATH.
#   YTDLP_BIN=/usr/local/bin/yt-dlp
#   FFMPEG_DIR=/usr/local/bin          # directory holding ffmpeg and ffprobe
# A Netscape-format cookies file lets yt-dlp fetch what a site only shows to a
# signed-in account (Instagram reels, some Facebook videos, YouTube from an
# address it distrusts). Export from a browser with a "cookies.txt" extension
# and mount it into the container; leave unset to fetch as an anonymous client.
#   IMPORT_COOKIES_FILE=/run/secrets/import-cookies.txt
# Instagram specifically shows reels to no anonymous server client, whatever
# the route. The `sessionid` cookie of any ordinary signed-in account (from a
# browser's cookie inspector, after logging in at instagram.com) lets the
# importer fetch what that account can see. Value only, no `sessionid=`.
#   INSTAGRAM_SESSIONID=

# Encrypted session cookies (AES-GCM via the cookie crate). Needs >=32 bytes.
# openssl rand -base64 48
SESSION_SECRET=

# Google sign-in. Absent -> "sign in" link redirects with a graceful error
# rather than the app failing to start. The OAuth client must list
# <SITE_ORIGIN>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails granted admin. Re-evaluated at every Google login, so
# this is the single source of truth -- a manual UPDATE on users.is_admin gets
# reverted the next time that person signs in.
ADMIN_EMAILS=

# Publish someone under a name that is not the one Google returns.
#   email=Display Name           -> that name, and no avatar at all
#   email=Display Name|https://… -> that name and that picture
# Comma-separated for several people. Substituted when the users row is written
# at sign-in, so the real name and picture never enter the database.
PSEUDONYMS=

# Cloudflare Web Analytics beacon token. Absent -> no script is emitted at all.
CF_ANALYTICS_TOKEN=

# Edge cache purge on delete. The zone the media domain is in, and an API
# token whose only permission is "Zone > Cache Purge" on that zone. With both
# set, an admin delete also purges the item's media URLs from Cloudflare's
# edge; without them the deleted thumbnail keeps serving from the CDN for as
# long as its one-year immutable lifetime lasts. Both or neither.
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=

# IndexNow key: any 8-128 alphanumeric characters. Absent -> no pings. Present
# -> every new item is pushed to Bing, Yandex and the other IndexNow engines
# the moment it publishes, and /<key>.txt serves the key back as proof.
INDEXNOW_KEY=

# Cloudflare Turnstile, the captcha in front of uploads and link imports.
# Both or neither: with either missing the widget is not rendered and the
# routes take requests without a token (fine locally, not in production).
# Create a widget at Cloudflare -> Turnstile, "managed" mode, with the site's
# hostname; the site key is public, the secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# An hourly pull from another gallery (see mirror.rs). Off unless
# MIRROR_SITEMAP names a sitemap -- a leaf that lists pages, or an index of
# sitemaps, whose children are followed. Every pass reads it, skips every link
# already on record as a source_url, and hands the rest to the ordinary importer.
#
# MIRROR_MATCH is a substring a link must contain to count, which is how a
# gallery that lists each item once per language is read once rather than
# twice: "/en/gallery/".
# MIRROR_EVERY_MINS defaults to 60 and is floored at 15.
# MIRROR_PER_RUN caps how many new links one pass takes on (default 40), so a
# first pass against a big gallery spreads out instead of queueing all of it.
MIRROR_SITEMAP=
MIRROR_MATCH=
MIRROR_EVERY_MINS=
MIRROR_PER_RUN=

# Cloudflare Tunnel. Production only -- it is how the container is reachable at
# all, and there is no local equivalent (dev serves on LEPTOS_SITE_ADDR directly).
CF_TUNNEL_TOKEN=

# Read by the deploy job, never by the app (see FLAVORS.md).
DEPLOY_HOST=
DEPLOY_HOST_KEY=
TS_CI_AUTHKEY=
LEGACY_COMPOSE=
